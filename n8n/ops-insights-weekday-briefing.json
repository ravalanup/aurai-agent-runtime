{
  "name": "Aurai ops-insights weekday briefing",
  "nodes": [
    {
      "id": "n1",
      "name": "Weekdays 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "n2",
      "name": "Start run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AURAI_RUNTIME_URL }}/v1/agents/ops-insights/runs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": { \"days\": 7 }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "aurai-n8n-client",
          "name": "Aurai agents (client credentials)"
        }
      }
    },
    {
      "id": "n3",
      "name": "Waiting for approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.status }}",
              "rightValue": "waiting_approval"
            }
          ]
        }
      }
    },
    {
      "id": "n4",
      "name": "Wait 15 minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        -120
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "minutes"
      }
    },
    {
      "id": "n5",
      "name": "Resume run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AURAI_RUNTIME_URL }}/v1/agents/ops-insights/runs/{{ $json.run_id }}/resume",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "aurai-n8n-client",
          "name": "Aurai agents (client credentials)"
        }
      }
    },
    {
      "id": "n6",
      "name": "Briefing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "status",
              "type": "string",
              "value": "={{ $json.status }}"
            },
            {
              "id": "a2",
              "name": "briefing",
              "type": "string",
              "value": "={{ $json.result.briefing }}"
            },
            {
              "id": "a3",
              "name": "actions",
              "type": "array",
              "value": "={{ $json.result.actions }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Weekdays 7am": {
      "main": [
        [
          {
            "node": "Start run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start run": {
      "main": [
        [
          {
            "node": "Waiting for approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Waiting for approval?": {
      "main": [
        [
          {
            "node": "Wait 15 minutes",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 15 minutes": {
      "main": [
        [
          {
            "node": "Resume run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resume run": {
      "main": [
        [
          {
            "node": "Waiting for approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "meta": {
    "description": "Starts the ops-insights agent each weekday and keeps resuming it until people have decided on its proposals. Approvals happen in the approval service, not in n8n."
  }
}